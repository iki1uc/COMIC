OS.sysview = {

  // interne Simulation statt echter Hardware
  read() {
    let hw = OS.hardware || {};

    return {
      cpu: hw.cpu?.load ?? 0,     // %
      ram: hw.ram?.used ?? 0,     // GB
      gpu: hw.gpu?.load ?? 0,     // %
      net: hw.net?.speed ?? 0,    // Mbit/s
      usb: hw.usb?.speed ?? 0,    // Mbit/s
      ssd: hw.ssd?.speed ?? 0     // MB/s
    };
  },

  // interne mathematische Zuwachsberechnung
  growth(hw) {
    return {
      usb: hw.usb > hw.net ? hw.usb - hw.net : 0,
      ssd: hw.ssd > hw.net ? hw.ssd - hw.net : 0
    };
  },

  // interne Bewertung (Alpha/Beta/Gamma)
  rating(hw) {

    if (hw.cpu < 20 && hw.ram < 4)
      return "Gamma · Rot";

    if (hw.cpu < 40 && hw.ram < 8)
      return "Beta · Gelb";

    if (hw.cpu >= 40 && hw.cpu <= 70)
      return "Alpha · Grün";

    if (hw.cpu > 80 || hw.gpu > 80)
      return "Alpha · Rot";

    return "Gamma · Grün";
  },

  // interne Gefahrstufe (für masterboot.start)
  danger(hw) {
    let r = this.rating(hw);

    if (r.includes("Rot")) return "ROT";
    if (r.includes("Gelb")) return "GELB";
    return "GRÜN";
  }
};
